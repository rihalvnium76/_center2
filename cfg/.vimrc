set encoding=utf-8      " Vim 内部内存编码
set fileencoding=utf-8  " 新建文件的默认编码
set termencoding=utf-8  " 终端输出编码

set number          " 显示行号
" set relativenumber  " 相对行号（便于上下移动）
set autoindent      " 自动缩进
set expandtab       " 用空格代替 Tab
set tabstop=4       " Tab 宽度 4 空格
set shiftwidth=4    " 缩进宽度 4 空格
set hlsearch        " 高亮搜索结果
set incsearch       " 增量搜索
set ignorecase      " 搜索忽略大小写
set smartcase       " 智能大小写（含大写则区分）
syntax on           " 语法高亮

set mouse=a
" set mouse=

" set langmenu=zh_CN.UTF-8
" language message zh_CN.UTF-8

